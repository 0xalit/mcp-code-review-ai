<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.projects</groupId>
	<artifactId>code-review-microservices</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<!-- THIS is the key change: "pom" means this project doesn't produce a JAR.
	     It only exists to coordinate its child modules. -->
	<packaging>pom</packaging>

	<name>Code Review Microservices</name>
	<description>Parent POM for the Code Review AI microservices</description>

	<properties>
		<java.version>21</java.version>
		<spring-ai.version>1.0.0-M7</spring-ai.version>
		<spring-cloud.version>2023.0.6</spring-cloud.version>
	</properties>

	<!-- List of child modules. Maven will build them in order. -->
	<modules>
		<module>common-models</module>
		<module>config-service</module>
		<module>code-tools-service</module>
		<module>gateway-service</module>
		<module>ai-review-service</module>
		<module>eureka-server</module>
	</modules>

	<!-- dependencyManagement does NOT add dependencies to children.
	     It only says: "IF a child declares this dependency, use THIS version."
	     This avoids version conflicts across services. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Dependencies declared here are automatically inherited by ALL child modules.
	     Only put things here that genuinely every service needs — don't over-share. -->
	<dependencies>
		<!-- Actuator — required for Spring Boot to activate the tracing auto-configuration.
		     Without this, micrometer-tracing and zipkin-reporter sit on the classpath but
		     are never wired up. Also enables /actuator/health for all services. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Micrometer Tracing — creates traceId/spanId, propagates them across HTTP calls,
		     and stamps them onto every log line automatically (no code changes needed in services) -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-brave</artifactId>
		</dependency>

		<!-- Zipkin Reporter — takes finished spans from Micrometer and POSTs them
		     to the Zipkin server at http://localhost:9411 so they appear in the UI -->
		<dependency>
			<groupId>io.zipkin.reporter2</groupId>
			<artifactId>zipkin-reporter-brave</artifactId>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>spring-milestones</id>
			<name>Spring Milestones</name>
			<url>https://repo.spring.io/milestone</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
	</repositories>

</project>
